{
	"$schema": "https://turbo.build/schema.json",
	"remoteCache": {
		"enabled": true,
		"signature": true
	},
	"globalPassThroughEnv": ["CI", "TURBO_TOKEN", "TURBO_TEAM", "TURBO_REMOTE_CACHE_SIGNATURE_KEY"],
	"tasks": {
		"transit": {
			"dependsOn": ["^transit"]
		},
		"generate:types": {
			"dependsOn": ["transit"],
			"outputs": ["openapi.json", "src/generated/**"]
		},
		"check:format": {
			"dependsOn": ["transit"],
			"outputs": []
		},
		"check:lint": {
			"dependsOn": ["transit"],
			"outputs": []
		},
		"check:typecheck": {
			"dependsOn": ["transit"],
			"outputs": [".cache/typecheck.tsbuildinfo"]
		},
		"test": {
			"dependsOn": ["transit"],
			"outputs": ["playwright-report/**", "test-results/**"]
		},
		"build": {
			"dependsOn": [
				"^build",
				"generate:types",
				"check:format",
				"check:lint",
				"check:typecheck",
				"@access/e2e#test"
			],
			"outputs": ["dist/**"]
		},
		"dev": {
			"dependsOn": ["generate:types"],
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"format:fix": {
			"cache": false
		},
		"lint:fix": {
			"cache": false
		}
	}
}
