{
	"$schema": "https://turbo.build/schema.json",
	"remoteCache": {
		"enabled": true,
		"signature": true
	},
	"globalPassThroughEnv": ["CI", "TURBO_TOKEN", "TURBO_TEAM", "TURBO_REMOTE_CACHE_SIGNATURE_KEY"],
	"tasks": {
		"run:typegen": {
			"outputs": ["src/_generated/**"]
		},
		"check:format": {
			"outputs": []
		},
		"check:lint": {
			"outputs": []
		},
		"check:typecheck": {
			"outputs": [".cache/typecheck.tsbuildinfo"]
		},
		"check": {
			"dependsOn": ["check:format", "check:lint", "check:typecheck"],
			"outputs": []
		},
		"build": {
			"outputs": ["dist/**"]
		},
		"test": {
			"outputs": ["playwright-report/**", "test-results/**"]
		},
		"dev": {
			"dependsOn": ["run:typegen"],
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"run:db": {
			"cache": false
		}
	}
}
