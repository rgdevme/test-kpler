{
	"name": "@access/e2e",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"check:format": "prettier --check . --ignore-path ../../.prettierignore",
		"check:lint": "eslint .",
		"check:typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
		"format:fix": "prettier --write . --ignore-path ../../.prettierignore",
		"lint:fix": "eslint . --fix",
		"stack:start": "tsx src/start-stack.ts",
		"test": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "catalog:",
		"@types/node": "catalog:",
		"tsx": "catalog:"
	}
}
