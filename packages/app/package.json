{
	"name": "@access/app",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"build": "vite build",
		"check:format": "prettier --check . --ignore-path ../../.prettierignore",
		"check:lint": "eslint .",
		"check:typecheck": "vue-tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
		"dev": "vite --host 0.0.0.0",
		"start": "vite preview --host 0.0.0.0"
	},
	"dependencies": {
		"@tanstack/vue-form": "catalog:",
		"@tanstack/vue-query": "catalog:",
		"@tanstack/vue-table": "catalog:",
		"openapi-fetch": "catalog:",
		"vue": "catalog:",
		"vue-router": "catalog:"
	},
	"devDependencies": {
		"@access/server": "workspace:*",
		"@tailwindcss/vite": "catalog:",
		"@vitejs/plugin-vue": "catalog:",
		"tailwindcss": "catalog:",
		"vite": "catalog:",
		"vue-tsc": "catalog:"
	}
}
