# ——————————————————————————————————————————————————————————————————————————
# ——— PostgreSQL: Stores users, roles, assignments, and audit history

# Use   : Connect the Nest server and database tooling to PostgreSQL.
# Source: Local Docker Compose or the target PostgreSQL provider.
# Path  : Provider dashboard > Database > Connection string
# E.g.  : postgresql://access:access@localhost:5432/access_portal
DATABASE_URL=postgresql://access:access@localhost:5432/access_portal

# ——————————————————————————————————————————————————————————————————————————
# ——— Server: Exposes the HTTP API

# Use   : Select the local HTTP port.
# Source: Application runtime configuration.
# Path  : Not applicable
# E.g.  : 3000
PORT=3000
