	"info": {
		"title": "Access Provisioning and Audit API",
		"description": "Manage user access levels and inspect the immutable access audit history.",
		"version": "1.0.0",
		"contact": {}
	},
	"tags": [
		{
			"name": "users",
			"description": ""
		},
		{
			"name": "roles",
			"description": ""
		},
		{
			"name": "audit",
			"description": ""
		},
		{
			"name": "health",
			"description": ""
		}
	],
	"servers": [],
	"components": {
		"securitySchemes": {
			"actor": {
				"type": "apiKey",
				"in": "header",
				"name": "x-actor-user-id"
			}
		},
		"schemas": {
			"RoleResponseDto": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"name": {
						"type": "string",
						"example": "Support"
					}
				},
				"required": [
					"id",
					"name"
				]
			},
			"UserResponseDto": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"displayName": {
						"type": "string",
						"example": "Olivia Operations"
					},
					"email": {
						"type": "string",
						"example": "olivia.operations@example.com",
						"format": "email"
					},
					"roles": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/RoleResponseDto"
						}
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					}
				},
				"required": [
					"id",
					"displayName",
					"email",
					"roles",
					"createdAt",
					"updatedAt"
				]
			},
			"CreateUserDto": {
				"type": "object",
				"properties": {
					"displayName": {
						"type": "string",
						"example": "Alex Analyst",
						"maxLength": 120,
						"minLength": 2
					},
					"email": {
						"type": "string",
						"example": "alex.analyst@example.com",
						"format": "email",
						"maxLength": 320
					},
					"roleIds": {
						"default": [],
						"type": "array",
						"items": {
							"type": "string",
							"format": "uuid"
						}
					}
				},
				"required": [
					"displayName",
					"email"
				]
			},
			"UpdateUserDto": {
				"type": "object",
				"properties": {
					"displayName": {
						"type": "string",
						"example": "Alex Analyst",
						"maxLength": 120,
						"minLength": 2
					},
					"roleIds": {
						"type": "array",
						"items": {
							"type": "string",
							"format": "uuid"
						}
					}
				},
				"required": [
					"displayName",
					"roleIds"
				]
			},
			"ReplaceUserRolesDto": {
				"type": "object",
				"properties": {
					"roleIds": {
						"type": "array",
						"items": {
							"type": "string",
							"format": "uuid"
						}
					}
				},
				"required": [
					"roleIds"
				]
			},
			"UserReferenceDto": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"displayName": {
						"type": "string",
						"example": "Olivia Operations"
					},
					"email": {
						"type": "string",
						"example": "olivia.operations@example.com",
						"format": "email"
					}
				},
				"required": [
					"id",
					"displayName",
					"email"
				]
			},
			"AuditLogResponseDto": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"action": {
						"type": "string",
						"enum": [
							"ROLES_CHANGED",
							"USER_CREATED"
						]
					},
					"actor": {
						"$ref": "#/components/schemas/UserReferenceDto"
					},
					"target": {
						"$ref": "#/components/schemas/UserReferenceDto"
					},
					"beforeRoles": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/RoleResponseDto"
						}
					},
					"afterRoles": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/RoleResponseDto"
						}
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					}
				},
				"required": [
					"id",
					"action",
					"actor",
					"target",
					"beforeRoles",
					"afterRoles",
					"createdAt"
				]
			},
			"HealthResponseDto": {
				"type": "object",
				"properties": {
					"status": {
						"type": "string",
						"example": "ok"
					}
				},
				"required": [
					"status"
				]
			}
		}
	}
}
